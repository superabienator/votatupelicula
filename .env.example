# ==============================================================================
# FRONTEND (Variables públicas para Vite / Vercel / Netlify / GitHub Pages)
# Si se dejan vacías, la app arranca en "Modo Demo Local" en memoria para probar
# toda la interfaz sin necesidad de configurar Supabase previamente.
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# BACKEND (Secretos privados en Supabase Edge Functions — NUNCA exponer en VITE_*)
# Configurar con: supabase secrets set CLAVE=valor
# ==============================================================================
# Clave maestra del usuario administrador para acceder al panel Admin y al Dashboard
# ADMIN_SECRET=cambia-esta-clave-segura

# Enriquecimiento automático gratuito de carteles y metadatos (Fase 1):
# TMDB_API_KEY=tu_api_key_o_read_access_token_de_themoviedb
# OMDB_API_KEY=opcional_fallback_omdb
# GEMINI_API_KEY=opcional_gemini_flash_para_sinopsis_juvenil_y_paleta

# Dispatcher de correo OTP gratuito (elige UNO):
# Opción A (0€ vía Gmail / Google Workspace del centro):
# GAS_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# GAS_WEBHOOK_SECRET=mismo_secreto_que_en_EmailRelay.gs
#
# Opción B (0€ vía Brevo - 300 emails/día sin dominio propio):
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=cineforum@tucentro.es
# MAIL_FROM_NAME=CineFórum ESO
#
# Opción C (0€ vía Resend - requiere dominio verificado):
# RESEND_API_KEY=re_...
# MAIL_FROM_EMAIL=votos@tudominio.es
#
# Opción D (Solo pruebas locales sin envío real de correo):
# OTP_DEV_MODE=false
